{
  "manifest_version": 3,
  "name": "STR Recorder",
  "version": "0.2.0",
  "description": "Record steps to reproduce a bug and let a local coding agent replay them to verify its fix.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "STR Recorder"
  },
  "commands": {
    "checkpoint": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Take a bug checkpoint"
    }
  }
}