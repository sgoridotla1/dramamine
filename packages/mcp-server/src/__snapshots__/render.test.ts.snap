// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`recording log > renders the cart recording 1`] = `
"# STR: Cart total shows $0
id: rec_1   start: http://localhost:3000/products.html
recorded: 1970-01-01 00:00 (8.0s)   viewport: 1280x800 @2x   browser: Chrome/153.0.0.0
steps: 2   checkpoints: 1   redacted values: 0

0.  start    http://localhost:3000/products.html
1.  click    getByTestId('product-card-1').getByRole('button', { name: 'Add to cart' })   (button 'Add to cart')
            alt: locator('div:nth-of-type(1) > button')  [fragile]
            net: POST /api/cart -> 201 (12ms)
2.  click    getByRole('link', { name: 'Cart' })   (link 'Cart')
            nav: -> /cart.html
            net: GET /api/cart -> 200 (4ms)
            console: warn "NaN passed to formatPrice"  at formatPrice (http://localhost:3000/pricing.js:9:13)

   CP#1 (checkpoint after step 2)
      target:   getByTestId('cart-total')   (cell)
      actual:   "$0"
      expected: "Total should be $42 (2 x $21)"   <- the user's words
      html:     <td data-testid="cart-total">$0</td>
      images:   "CP#1 region" and "CP#1 viewport" attached below"
`;

exports[`replay report > renders a green verification 1`] = `
"# Replay: Cart total shows $0  [GREEN]
GREEN - every evaluated check passed.
recording: rec_1   start: http://localhost:3000/products.html   duration: 3.2s

steps:
   1.  click     ok  via getByTestId('product-card-1').getByRole('button', { name: 'Add to cart' })
   2.  click     ok  via getByRole('link', { name: 'Cart' })

checkpoints:
   CP#1
      recorded: "$0"
      replayed: "$42"
      expected (user): "Total should be $42 (2 x $21)"
      PASS  text-contains "$42" -> actual "$42"

global checks:
      PASS  no-uncaught-exceptions -> actual "no exceptions""
`;

exports[`replay report > renders a red baseline 1`] = `
"# Replay: Cart total shows $0  [RED]
RED - at least one check failed: the bug reproduces (or the check does not match the fixed behaviour).
recording: rec_1   start: http://localhost:3000/products.html   duration: 3.2s

warnings:
   - The recording made 1 non-GET request(s) (POST /api/cart). Server state may differ from the recording, so results may drift.

steps:
   1.  click     ok  via getByTestId('product-card-1').getByRole('button', { name: 'Add to cart' })
   2.  click     ok  via getByRole('link', { name: 'Cart' })

checkpoints:
   CP#1
      recorded: "$0"
      replayed: "$0"
      expected (user): "Total should be $42 (2 x $21)"
      FAIL  text-contains "$42" -> actual "$0"

global checks:
      PASS  no-uncaught-exceptions -> actual "no exceptions""
`;

exports[`replay report > renders an error with the failed step, skipped steps and unreached checkpoints 1`] = `
"# Replay: Cart total shows $0  [ERROR]
ERROR - a step could not be performed or a checked element was not found, so this replay says nothing about the bug.
recording: rec_1   start: http://localhost:3000/products.html   duration: 3.2s

warnings:
   - The recording made 1 non-GET request(s) (POST /api/cart). Server state may differ from the recording, so results may drift.

steps:
   1.  click     ok  via locator('div:nth-of-type(1) > button')  [fragile]  [fallback: candidate 2]
   2.  click     FAILED: getByRole('link', { name: 'Cart' }) matched no elements
        tried: getByRole('link', { name: 'Cart' })

checkpoints:
   CP#1  NOT REACHED
      recorded: "$0"
      expected (user): "Total should be $42 (2 x $21)"
      SKIP  text-contains "$42"  (step 2 failed before this checkpoint)"
`;

exports[`replay report > renders an unchecked replay with a judged check and replay errors 1`] = `
"# Replay: Cart total shows $0  [UNCHECKED]
UNCHECKED - no deterministic checks were evaluated (none were given, or only judge checks).
recording: rec_1   start: http://localhost:3000/products.html   duration: 3.2s

steps:
   1.  click     ok  via getByTestId('product-card-1').getByRole('button', { name: 'Add to cart' })
   2.  click     ok  via getByRole('link', { name: 'Cart' })

checkpoints:
   CP#1
      recorded: "$0"
      replayed: "$0"
      expected (user): "Total should be $42 (2 x $21)"
      JUDGE judge -> actual "$0"  (compare the screenshots below)

errors during replay:
   step 2: exception "TypeError: Cannot read properties of undefined (reading 'title')"

failed requests during replay:
   step 2: GET /api/fail -> 500"
`;
